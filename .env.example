# PocketBase instance used by the contact form (server-side only, never exposed to the browser).
# Set this as an Environment Variable in Vercel (Project Settings -> Environment Variables).
POCKETBASE_URL=https://your-instance.pockethost.io

# Optional. Canonical origin used for SEO tags, sitemap and share images.
# On Vercel it falls back to the project's production domain automatically;
# set this once the custom domain is live.
SITE_URL=https://miningconsultants.com.au
